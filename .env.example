APP_NAME=Kryx
APP_VERSION=0.1.0

LOG_LEVEL=INFO

# Path to the sqlite file inside the container. Matches the kryx-data
# volume mount in docker-compose.yml - leave as-is unless that changes.
DATABASE_PATH=/data/autosend.db

# Set true to log outbound WhatsApp sends instead of calling the Graph API.
DRY_RUN=false

# Enables the PCO registration/form-response poller loop. Only relevant for
# organisations with the PCO module enabled - safe to leave false otherwise.
ENABLE_POLLER=false
REGISTRATION_POLL_INTERVAL_MINUTES=2

# WhatsApp/PCO credentials are no longer set here - each organisation's
# tokens are entered via the admin UI and stored Fernet-encrypted in the
# database, keyed by TOKEN_ENCRYPTION_KEY below.

# X-Admin-Key header for the /ops/* JSON endpoints in main.py.
ADMIN_API_KEY=

# Encrypts every stored credential at rest (WhatsApp access tokens, PCO
# tokens, Meta app secrets). Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse the placeholder default baked into config.py - regenerate
# per environment.
TOKEN_ENCRYPTION_KEY=

# Signs the SQLAdmin + /login session cookie. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Error monitoring. Leave blank to disable entirely (safe for local dev).
# Get a DSN from sentry.io (or a self-hosted GlitchTip instance).
SENTRY_DSN=
ENVIRONMENT=production
